{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowme.local/schemas/literal-ics-graph-v1.schema.json",
  "title": "FlowMe Literal ICS-first Graph v1 Lab Record",
  "description": "Strict schema for one record in runs/literal-ics-first/results-v1.json. Passing this structural schema does not mean the contender passes the FlowMe semantic hard gates: VJOURNAL and RELATED-TO hierarchy preservation remain scored interoperability risks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "architecture",
    "bundleId",
    "title",
    "mapType",
    "sampleUserOverlay",
    "attribution",
    "calendar",
    "canonicalLimitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "flowme-literal-ics-graph-v1"
    },
    "architecture": {
      "const": "literal_ics_first"
    },
    "bundleId": {
      "$ref": "https://flowme.local/schemas/current-canonical-v1.schema.json#/$defs/id"
    },
    "title": {
      "$ref": "https://flowme.local/schemas/current-canonical-v1.schema.json#/$defs/nonEmptyString"
    },
    "mapType": {
      "$ref": "https://flowme.local/schemas/current-canonical-v1.schema.json#/$defs/mapType"
    },
    "sampleUserOverlay": {
      "$ref": "https://flowme.local/schemas/current-canonical-v1.schema.json#/$defs/sampleUserOverlay"
    },
    "attribution": {
      "$ref": "https://flowme.local/schemas/current-canonical-v1.schema.json#/$defs/attribution"
    },
    "calendar": {
      "$ref": "#/$defs/calendar"
    },
    "canonicalLimitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://flowme.local/schemas/current-canonical-v1.schema.json#/$defs/nonEmptyString"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "relatedTo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reltype",
        "uid"
      ],
      "properties": {
        "reltype": {
          "const": "PARENT"
        },
        "uid": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "RFC RELATED-TO linkage is a flat relation, not nested VEVENT or VTODO."
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uid",
        "summary",
        "xFlowmeKind"
      ],
      "properties": {
        "kind": {
          "const": "VJOURNAL"
        },
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "xFlowmeKind": {
          "enum": [
            "MAP",
            "FLOW",
            "STEP"
          ]
        },
        "relatedTo": {
          "$ref": "#/$defs/relatedTo"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "xFlowmeKind": {
                "const": "MAP"
              }
            },
            "required": [
              "xFlowmeKind"
            ]
          },
          "then": {
            "not": {
              "properties": {
                "relatedTo": {}
              },
              "required": [
                "relatedTo"
              ]
            }
          },
          "else": {
            "required": [
              "relatedTo"
            ],
            "properties": {
              "relatedTo": {
                "$ref": "#/$defs/relatedTo"
              }
            }
          }
        }
      ],
      "description": "The serializer supplies UID and DTSTAMP to the emitted VJOURNAL component. This graph records the source hierarchy experiment."
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uid",
        "summary",
        "description",
        "dtstart",
        "status",
        "url",
        "relatedTo",
        "xFlowmeKind",
        "sourceRowIds"
      ],
      "properties": {
        "kind": {
          "const": "VEVENT"
        },
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "dtstart": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "type": "null"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "relatedTo": {
          "$ref": "#/$defs/relatedTo"
        },
        "xFlowmeKind": {
          "const": "ITEM"
        },
        "sourceRowIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://flowme.local/schemas/current-canonical-v1.schema.json#/$defs/id"
          }
        }
      },
      "description": "VEVENT always has a resolved DTSTART. Scheduleless Items are forbidden from this branch."
    },
    "todo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uid",
        "summary",
        "description",
        "dtstart",
        "status",
        "url",
        "relatedTo",
        "xFlowmeKind",
        "sourceRowIds"
      ],
      "properties": {
        "kind": {
          "const": "VTODO"
        },
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "dtstart": {
          "type": "null"
        },
        "status": {
          "const": "NEEDS-ACTION"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "relatedTo": {
          "$ref": "#/$defs/relatedTo"
        },
        "xFlowmeKind": {
          "const": "ITEM"
        },
        "sourceRowIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://flowme.local/schemas/current-canonical-v1.schema.json#/$defs/id"
          }
        }
      },
      "description": "An undated execution Item is represented as VTODO, never as a scheduleless VEVENT."
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prodid",
        "version",
        "method",
        "components"
      ],
      "properties": {
        "prodid": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "2.0"
        },
        "method": {
          "type": "null"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/journal"
              },
              {
                "$ref": "#/$defs/event"
              },
              {
                "$ref": "#/$defs/todo"
              }
            ]
          },
          "description": "All components are siblings in VCALENDAR. The strict component schemas have no child component property, so VEVENT and VTODO nesting is impossible."
        }
      }
    }
  }
}
