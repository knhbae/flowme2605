{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowme.local/schemas/flow-content-value-qualified-benchmark-v1.schema.json",
  "title": "Flow Content Value-Qualified Benchmark v1 artifact contract",
  "description": "Machine-readable contract for candidate admission, sealed splits, gold contracts, independent conversion runs, metrics, and final adjudication. The repository validator applies cross-file invariants that JSON Schema cannot express by itself.",
  "anyOf": [
    { "$ref": "#/$defs/candidatePoolArtifact" },
    { "$ref": "#/$defs/selectedPositiveArtifact" },
    { "$ref": "#/$defs/boundaryControlArtifact" },
    { "$ref": "#/$defs/goldContractArtifact" },
    { "$ref": "#/$defs/runResultsArtifact" },
    { "$ref": "#/$defs/sealArtifact" },
    { "$ref": "#/$defs/genericBenchmarkArtifact" },
    { "$ref": "#/$defs/generatedArrayArtifact" }
  ],
  "$defs": {
    "schemaVersion": {
      "const": "flow-content-value-qualified-benchmark-v1"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "artifact": {
      "enum": ["calendar", "checklist", "todo", "sheet", "memo"]
    },
    "stopStatus": {
      "enum": ["source_import_required", "hold", "blocked"]
    },
    "positiveStatus": {
      "enum": ["ready", "needs_confirmation"]
    },
    "gateValue": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:pass|fail|review_required|unknown)"
    },
    "gateSet": {
      "type": "object",
      "required": ["source", "rights", "locale", "safety"],
      "properties": {
        "source": { "$ref": "#/$defs/gateValue" },
        "rights": { "$ref": "#/$defs/gateValue" },
        "locale": { "$ref": "#/$defs/gateValue" },
        "safety": { "$ref": "#/$defs/gateValue" },
        "privacy": { "$ref": "#/$defs/gateValue" },
        "oneJob": { "$ref": "#/$defs/gateValue" },
        "naturalArtifact": { "$ref": "#/$defs/gateValue" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "type", "claim", "url", "observedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "claim": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "$ref": "#/$defs/uri" },
        "observedAt": { "type": "string", "format": "date" },
        "evidenceClass": { "type": "string" }
      },
      "additionalProperties": true
    },
    "score": {
      "type": "object",
      "required": ["points", "max", "comment", "evidenceRefs"],
      "properties": {
        "points": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "comment": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "additionalProperties": false
    },
    "scoreSet": {
      "type": "object",
      "required": [
        "visibleDemand",
        "interaction",
        "sourceRowFeasibility",
        "creatorBusinessValue",
        "flowValueDelta",
        "portfolioExpansion"
      ],
      "properties": {
        "visibleDemand": { "$ref": "#/$defs/score" },
        "interaction": { "$ref": "#/$defs/score" },
        "sourceRowFeasibility": { "$ref": "#/$defs/score" },
        "creatorBusinessValue": { "$ref": "#/$defs/score" },
        "flowValueDelta": { "$ref": "#/$defs/score" },
        "portfolioExpansion": { "$ref": "#/$defs/score" }
      },
      "additionalProperties": false
    },
    "rightsSeparation": {
      "type": "object",
      "required": ["personalConversion", "publicCatalog"],
      "properties": {
        "personalConversion": { "$ref": "#/$defs/nonEmptyString" },
        "publicCatalog": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidateId",
        "title",
        "canonicalUrl",
        "provider",
        "providerType",
        "locale",
        "sourceFormat",
        "evidence",
        "scores",
        "computedTotal",
        "hardGates",
        "rights",
        "valueDelta",
        "qualified",
        "selection"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "canonicalUrl": { "$ref": "#/$defs/uri" },
        "provider": { "$ref": "#/$defs/nonEmptyString" },
        "providerType": { "$ref": "#/$defs/nonEmptyString" },
        "locale": { "$ref": "#/$defs/nonEmptyString" },
        "sourceFormat": { "$ref": "#/$defs/nonEmptyString" },
        "priorUse": { "type": "string" },
        "evidence": {
          "type": "array",
          "minItems": 6,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "scores": { "$ref": "#/$defs/scoreSet" },
        "computedTotal": { "type": "number", "minimum": 0, "maximum": 100 },
        "hardGates": { "$ref": "#/$defs/gateSet" },
        "rights": { "$ref": "#/$defs/rightsSeparation" },
        "valueDelta": {
          "type": "object",
          "required": ["sourceLinkOnlyLimit", "persistentState", "returnMoment", "naturalArtifact"],
          "properties": {
            "sourceLinkOnlyLimit": { "$ref": "#/$defs/nonEmptyString" },
            "persistentState": { "$ref": "#/$defs/nonEmptyString" },
            "returnMoment": { "$ref": "#/$defs/nonEmptyString" },
            "naturalArtifact": {
              "oneOf": [
                { "$ref": "#/$defs/artifact" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": true
        },
        "qualified": { "type": "boolean" },
        "selection": { "$ref": "#/$defs/nonEmptyString" },
        "rejectionReason": { "type": ["string", "null"] },
        "quotaOverride": { "const": false }
      },
      "additionalProperties": true
    },
    "sourceRow": {
      "type": "object",
      "required": ["id", "order", "title", "detail", "kind", "locator"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "locator": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": true
    },
    "schedule": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "type": "string" },
        "date": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "due": { "type": "string" },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["title", "detail", "completion"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "$ref": "#/$defs/nonEmptyString" },
        "completion": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "object", "minProperties": 1 }
          ]
        },
        "schedule": { "$ref": "#/$defs/schedule" },
        "location": { "type": ["object", "string", "null"] },
        "fields": { "type": ["array", "object"] },
        "conditions": { "type": ["array", "object"] },
        "sourceRowRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "anyOf": [
        { "required": ["sourceRowRefs"] },
        { "required": ["sourceRefs"] }
      ],
      "additionalProperties": true
    },
    "benchmarkCase": {
      "type": "object",
      "required": [
        "caseId",
        "candidateId",
        "split",
        "class",
        "title",
        "sourceShape",
        "sourceRows",
        "minimumInputs",
        "primaryArtifact",
        "secondaryArtifacts",
        "status",
        "publicReleaseAllowed",
        "privateConversionAllowed",
        "gates"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/nonEmptyString" },
        "candidateId": { "$ref": "#/$defs/nonEmptyString" },
        "split": { "enum": ["calibration", "final_holdout"] },
        "class": { "enum": ["positive", "boundary"] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "sourceShape": { "$ref": "#/$defs/nonEmptyString" },
        "userJob": { "type": ["string", "null"] },
        "sourceRows": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRow" }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        },
        "minimumInputs": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "optionalInputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "primaryArtifact": {
          "oneOf": [
            { "$ref": "#/$defs/artifact" },
            { "type": "null" }
          ]
        },
        "secondaryArtifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "status": {
          "enum": ["ready", "needs_confirmation", "source_import_required", "hold", "blocked"]
        },
        "publicReleaseAllowed": { "type": "boolean" },
        "privateConversionAllowed": { "type": "boolean" },
        "gates": { "$ref": "#/$defs/gateSet" }
      },
      "allOf": [
        {
          "if": { "properties": { "class": { "const": "positive" } } },
          "then": {
            "properties": {
              "sourceRows": { "minItems": 1 },
              "userJob": { "$ref": "#/$defs/nonEmptyString" },
              "primaryArtifact": { "$ref": "#/$defs/artifact" },
              "status": { "$ref": "#/$defs/positiveStatus" }
            }
          }
        },
        {
          "if": { "properties": { "class": { "const": "boundary" } } },
          "then": {
            "properties": {
              "sourceRows": { "maxItems": 0 },
              "items": { "maxItems": 0 },
              "primaryArtifact": { "type": "null" },
              "secondaryArtifacts": { "maxItems": 0 },
              "status": { "$ref": "#/$defs/stopStatus" },
              "publicReleaseAllowed": { "const": false },
              "privateConversionAllowed": { "const": false }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "runResult": {
      "type": "object",
      "required": [
        "caseId",
        "role",
        "flowPossible",
        "status",
        "items",
        "minimumInputs",
        "primaryProjection",
        "secondaryProjections",
        "gates",
        "publicReleaseAllowed",
        "privateConversionAllowed"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "enum": ["rules", "low_cost", "low-cost", "high_capability", "high-capability"] },
        "phase": { "enum": ["calibration", "final_holdout"] },
        "flowPossible": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "enum": ["ready", "needs_confirmation", "source_import_required", "hold", "blocked"]
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        },
        "minimumInputs": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "primaryProjection": {
          "oneOf": [
            { "$ref": "#/$defs/artifact" },
            { "type": "null" }
          ]
        },
        "secondaryProjections": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "gates": { "$ref": "#/$defs/gateSet" },
        "publicReleaseAllowed": { "type": "boolean" },
        "privateConversionAllowed": { "type": "boolean" },
        "projections": { "type": "object" },
        "processor": { "type": "object" }
      },
      "additionalProperties": true
    },
    "candidatePoolArtifact": {
      "type": "object",
      "required": ["schemaVersion", "candidates"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "artifactType": { "const": "candidate_pool" },
        "candidates": {
          "type": "array",
          "minItems": 40,
          "maxItems": 40,
          "items": { "$ref": "#/$defs/candidate" }
        }
      },
      "additionalProperties": true
    },
    "selectedPositiveArtifact": {
      "type": "object",
      "required": ["candidates"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "artifactType": { "const": "selected_positive_set" },
        "positiveSet": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "candidates": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "quotaOverrideCount": { "const": 0 }
      },
      "additionalProperties": true
    },
    "boundaryControlArtifact": {
      "type": "object",
      "required": ["cases"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "artifactType": { "const": "boundary_control_set" },
        "boundarySet": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/benchmarkCase" }
        },
        "cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/benchmarkCase" }
        }
      },
      "additionalProperties": true
    },
    "goldContractArtifact": {
      "type": "object",
      "required": ["cases"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "artifactType": { "const": "gold_source_contract" },
        "cases": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": { "$ref": "#/$defs/goldCase" }
        }
      },
      "additionalProperties": true
    },
    "runResultsArtifact": {
      "type": "object",
      "anyOf": [
        { "required": ["results"] },
        { "required": ["cases"] }
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "artifactType": { "enum": ["calibration_results", "final_holdout_results", "role_run_results"] },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/runResult" }
        },
        "cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/runResult" }
        }
      },
      "additionalProperties": true
    },
    "sealArtifact": {
      "type": "object",
      "required": ["schemaVersion", "postHoldoutMutationCount"],
      "properties": {
        "schemaVersion": { "enum": ["flow-content-value-qualified-benchmark-v1", "value-qualified-benchmark-seal-v1"] },
        "artifactType": { "const": "benchmark_seal" },
        "hashes": {
          "oneOf": [
            {
              "type": "object",
              "minProperties": 5,
              "additionalProperties": {
                "oneOf": [
                  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  {
                    "type": "object",
                    "required": ["path", "sha256"],
                    "properties": {
                      "path": { "$ref": "#/$defs/nonEmptyString" },
                      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                    }
                  }
                ]
              }
            },
            {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "object",
                "required": ["path", "sha256"],
                "properties": {
                  "path": { "$ref": "#/$defs/nonEmptyString" },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            }
          ]
        },
        "rubricHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "hardGateContractHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "candidatePoolHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceEvidencePacketHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "splitHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "blindCalibrationPacketHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "blindFinalHoldoutPacketHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baselineRulesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baselinePromptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "revisedRulesHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "goldContractHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "correctionLogHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "unscoredAttemptCount": { "type": "integer", "minimum": 0 },
        "scoredHoldoutAttempt": { "type": "integer", "minimum": 1 },
        "correctionLogPath": { "type": "string", "minLength": 1 },
        "unscoredAttemptArchivePaths": {
          "type": "array",
          "items": { "type": ["string", "object"] }
        },
        "scoredHoldoutRunPaths": {
          "type": "array",
          "items": { "type": ["string", "object"] }
        },
        "postHoldoutMutationCount": { "const": 0 }
      },
      "anyOf": [
        { "required": ["hashes"] },
        {
          "required": [
            "rubricHash",
            "hardGateContractHash",
            "candidatePoolHash",
            "sourceEvidencePacketHash",
            "splitHash",
            "blindCalibrationPacketHash",
            "blindFinalHoldoutPacketHash",
            "baselineRulesHash",
            "baselinePromptHash"
          ]
        }
      ],
      "additionalProperties": true
    },
    "genericBenchmarkArtifact": {
      "type": "object",
      "required": ["schemaVersion", "artifactType"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "artifactType": {
          "enum": [
            "value_admission_contract",
            "admission_scorecard",
            "rejected_candidates",
            "source_evidence",
            "model_comparison",
            "value_and_conversion_metrics",
            "final_adjudication",
            "prior_benchmark_reinterpretation"
          ]
        }
      },
      "additionalProperties": true
    },
    "goldCase": {
      "type": "object",
      "required": [
        "caseId",
        "candidateId",
        "split",
        "goldClass",
        "source",
        "flowPossible",
        "sourceRows",
        "allowedItems",
        "minimumInputs",
        "primaryProjection",
        "secondaryProjections",
        "gates",
        "publicReleaseAllowed",
        "privateConversionAllowed",
        "status"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/nonEmptyString" },
        "candidateId": { "$ref": "#/$defs/nonEmptyString" },
        "split": { "enum": ["calibration", "final_holdout"] },
        "goldClass": { "enum": ["positive", "boundary"] },
        "source": { "type": "object" },
        "flowPossible": { "type": "boolean" },
        "sourceRows": { "type": "array", "items": { "$ref": "#/$defs/sourceRow" } },
        "allowedItems": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "minimumInputs": { "type": "array", "maxItems": 2 },
        "primaryProjection": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
        "secondaryProjections": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/artifact" } },
        "gates": { "$ref": "#/$defs/gateSet" },
        "publicReleaseAllowed": { "type": "boolean" },
        "privateConversionAllowed": { "type": "boolean" },
        "status": { "enum": ["ready", "needs_confirmation", "source_import_required", "hold", "blocked"] }
      },
      "additionalProperties": true
    },
    "generatedArrayArtifact": {
      "type": "object",
      "required": ["generatedAt"],
      "anyOf": [
        { "required": ["rows"] },
        { "required": ["candidates"] },
        { "required": ["cases"] },
        { "required": ["evidence"] },
        { "required": ["evaluations"] }
      ],
      "additionalProperties": true
    }
  }
}
