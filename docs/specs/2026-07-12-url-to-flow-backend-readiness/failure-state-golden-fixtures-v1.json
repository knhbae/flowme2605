  "purpose": "Provider-neutral planning fixtures for URL-to-Flow content gates, proposal validation, projection loss, and retry-safe runtime failures.",
  "contract": {
    "generationStatuses": [
      "ready",
      "generating",
      "proposal",
      "partial",
      "failed",
      "reviewed",
      "saved"
    ],
    "terminalStatusesUnderTest": [
      "partial",
      "failed"
    ],
    "normalizedOutcomes": [
      "complete",
      "partial",
      "no_proposal",
      "rejected",
      "cancelled"
    ],
    "conversionReadiness": [
      "ready_for_internal_canary",
      "ready_second_wave",
      "source_import_required",
      "hold"
    ],
    "nullReadinessMeaning": "Readiness is not applicable when the attempt ended before source evaluation or conversion was rejected because no executable user job exists. It must not be converted to hold or source_import_required automatically.",
    "projectionTargets": [
      "calendar",
      "checklist",
      "todo",
      "sheet",
      "memo"
    ],
    "globalRules": {
      "noProjectionBeforeReviewedSave": true,
      "noAutomaticRetry": true,
      "noAutomaticSave": true,
      "failedAttemptIsImmutable": true,
      "preserveSubmittedInput": true
    },
    "requiredCases": [
      "missing_source_rows",
      "locale_mismatch_sensitive",
      "unreadable_or_paywalled",
      "no_executable_user_job",
      "multiple_primary_sources",
      "invented_action",
      "invented_schedule_ics",
      "runtime_fetch_timeout"
    ]
  },
