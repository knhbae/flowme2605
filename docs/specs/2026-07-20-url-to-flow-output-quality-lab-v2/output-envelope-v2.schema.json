{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowme.local/schemas/url-to-flow-output-envelope-v2.json",
  "title": "FlowMe URL-to-Flow output envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelopeSchemaVersion",
    "caseId",
    "requestId",
    "sourceEvidence",
    "feasibility",
    "classification",
    "canonicalDraft",
    "projections",
    "reviewEvidence"
  ],
  "properties": {
    "envelopeSchemaVersion": { "const": "flowme-url-to-flow-output-envelope-v2" },
    "caseId": { "$ref": "#/$defs/nonEmptyString" },
    "requestId": { "$ref": "#/$defs/nonEmptyString" },
    "sourceEvidence": { "$ref": "#/$defs/sourceEvidence" },
    "feasibility": { "$ref": "#/$defs/feasibility" },
    "classification": { "$ref": "#/$defs/classification" },
    "canonicalDraft": { "$ref": "#/$defs/canonicalDraft" },
    "projections": { "$ref": "#/$defs/projections" },
    "reviewEvidence": { "$ref": "#/$defs/reviewEvidence" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableString": { "type": ["string", "null"] },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
    "lifeArea": { "enum": ["home_living", "family_parenting", "study_reading", "money_admin_purchase", "health_fitness", "travel_outings", "meals_grocery", "work_career", "hobby_pet"] },
    "sourceShape": { "enum": ["single_action", "checklist_rows", "date_offsets", "date_window", "recurrence_rule", "procedure_rows", "table_rows", "lesson_rows", "resource_collection", "decision_criteria", "narrative_guidance", "template_fields"] },
    "executionPattern": { "enum": ["date_preparation", "ordered_procedure", "repeating_routine", "progress_tracking", "resource_queue", "compare_decide", "phase_lifecycle"] },
    "artifact": { "enum": ["calendar", "checklist", "todo", "sheet", "memo"] },
    "sourceRowStatus": { "enum": ["complete", "partial", "metadata_only", "missing"] },
    "conversionReadiness": { "enum": ["ready_for_internal_canary", "ready_second_wave", "source_import_required", "hold"] },
    "blocker": { "enum": ["source_unavailable", "source_incomplete", "source_import_required", "rights_unknown", "rights_permission_required", "rights_blocked", "freshness_pending", "stale_source", "locale_review_required", "safety_review_required", "privacy_review_required", "account_or_entitlement_required", "user_input_required", "source_conflict", "unsupported_shape", "editorial_review_required"] },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "capturedAt", "contentHash", "locator"],
      "properties": {
        "snapshotId": { "$ref": "#/$defs/nonEmptyString" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "contentHash": { "$ref": "#/$defs/nonEmptyString" },
        "locator": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "primarySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "url", "title", "snapshot"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "type": "string", "format": "uri" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "snapshot": { "$ref": "#/$defs/snapshot" }
      }
    },
    "sourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRowId", "sourceId", "snapshotId", "rowType", "title", "detail", "order", "locator"],
      "properties": {
        "sourceRowId": { "$ref": "#/$defs/nonEmptyString" },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "snapshotId": { "$ref": "#/$defs/nonEmptyString" },
        "rowType": { "enum": ["check", "condition", "date", "offset", "omission", "procedure", "reference", "resource", "table_row"] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 },
        "locator": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landmarkId", "label", "sourceRowIds"],
      "properties": {
        "landmarkId": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRowIds": { "$ref": "#/$defs/stringArray" }
      }
    },
    "missingRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "reason"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "roleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRowId", "role", "targetIds", "reason"],
      "properties": {
        "sourceRowId": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "enum": ["item", "field", "memo", "reference", "conditional_response", "omission"] },
        "targetIds": { "$ref": "#/$defs/stringArray" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primarySource", "claimedScope", "sourceCompleteness", "sourceRows", "landmarks", "missingRows", "roleAssignments"],
      "properties": {
        "primarySource": { "$ref": "#/$defs/primarySource" },
        "claimedScope": { "$ref": "#/$defs/nonEmptyString" },
        "sourceCompleteness": { "$ref": "#/$defs/sourceRowStatus" },
        "sourceRows": { "type": "array", "items": { "$ref": "#/$defs/sourceRow" } },
        "landmarks": { "type": "array", "items": { "$ref": "#/$defs/landmark" } },
        "missingRows": { "type": "array", "items": { "$ref": "#/$defs/missingRow" } },
        "roleAssignments": { "type": "array", "items": { "$ref": "#/$defs/roleAssignment" } }
      }
    },
    "feasibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationState", "outcome", "conversionReadiness", "errorCode", "blockers", "executableAllowed", "publicExportAllowed", "reason"],
      "properties": {
        "generationState": { "enum": ["completed", "failed"] },
        "outcome": { "enum": ["proposal", "no_proposal", "rejected"] },
        "conversionReadiness": { "$ref": "#/$defs/conversionReadiness" },
        "errorCode": { "$ref": "#/$defs/nullableString" },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" }, "uniqueItems": true },
        "executableAllowed": { "type": "boolean" },
        "publicExportAllowed": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "taxonomyAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classificationStatus", "primaryLifeArea", "secondaryLifeAreas", "topicTags", "sourceShape", "secondarySourceShapes", "primaryExecutionPattern", "secondaryExecutionPatterns", "primaryArtifact", "secondaryArtifacts"],
      "properties": {
        "classificationStatus": { "enum": ["confirmed", "provisional", "blocked_missing_source"] },
        "primaryLifeArea": { "$ref": "#/$defs/lifeArea" },
        "secondaryLifeAreas": { "type": "array", "items": { "$ref": "#/$defs/lifeArea" }, "uniqueItems": true, "maxItems": 2 },
        "topicTags": { "$ref": "#/$defs/stringArray" },
        "sourceShape": { "oneOf": [{ "$ref": "#/$defs/sourceShape" }, { "type": "null" }] },
        "secondarySourceShapes": { "type": "array", "items": { "$ref": "#/$defs/sourceShape" }, "uniqueItems": true, "maxItems": 2 },
        "primaryExecutionPattern": { "oneOf": [{ "$ref": "#/$defs/executionPattern" }, { "type": "null" }] },
        "secondaryExecutionPatterns": { "type": "array", "items": { "$ref": "#/$defs/executionPattern" }, "uniqueItems": true, "maxItems": 2 },
        "primaryArtifact": { "oneOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
        "secondaryArtifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" }, "uniqueItems": true, "maxItems": 4 }
      }
    },
    "sourceFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "mediaType", "detail"],
      "properties": {
        "category": { "enum": ["article", "checklist", "table", "document", "video", "audio", "course", "collection", "template", "api_feed", "interactive_page"] },
        "mediaType": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "type": "object" }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerType", "platformRoles", "discoveryAccess", "rowAccess", "acquisitionMethods", "sourceFormat"],
      "properties": {
        "providerType": { "enum": ["government_public", "public_institution", "brand_official", "creator", "editorial_media", "community_platform", "marketplace", "education_provider", "open_knowledge", "aggregator", "user_owned"] },
        "platformRoles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["discover", "host", "distribute", "execute", "export_destination", "entitlement", "community_signal"] } },
        "discoveryAccess": { "enum": ["public", "account_required", "paywalled", "robots_limited", "unavailable", "unknown"] },
        "rowAccess": { "enum": ["full", "partial", "metadata_only", "unavailable", "unknown"] },
        "acquisitionMethods": { "type": "array", "uniqueItems": true, "items": { "enum": ["html_fetch", "pdf_fetch", "rss_fetch", "public_api", "oauth_api", "file_upload", "manual_copy", "transcript_import", "table_import", "creator_delivery"] } },
        "sourceFormat": { "$ref": "#/$defs/sourceFormat" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "allowedUse", "territoryScope", "territories", "reviewStatus", "personalTransformAllowed", "publicReleaseAllowed", "rationale"],
      "properties": {
        "basis": { "enum": ["public_domain", "open_license", "official_reuse_policy", "provider_terms", "creator_permission", "user_owned", "link_only_assumption", "unknown", "blocked"] },
        "allowedUse": { "type": "array", "uniqueItems": true, "items": { "enum": ["link_metadata", "personal_transform", "internal_review", "public_derived", "public_republish"] } },
        "territoryScope": { "enum": ["global", "named", "unknown"] },
        "territories": { "$ref": "#/$defs/stringArray" },
        "reviewStatus": { "enum": ["not_required", "pending", "approved", "restricted", "blocked"] },
        "personalTransformAllowed": { "type": "boolean" },
        "publicReleaseAllowed": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "reviewState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRowStatus", "conversionReadiness", "freshnessReview", "localeReview", "safetyReview", "privacyReview", "rightsReview", "promotionState", "blockers", "portfolioRole", "editorialAction", "backendStorable"],
      "properties": {
        "sourceRowStatus": { "$ref": "#/$defs/sourceRowStatus" },
        "conversionReadiness": { "$ref": "#/$defs/conversionReadiness" },
        "freshnessReview": { "enum": ["not_required", "pending", "current", "stale", "unknown"] },
        "localeReview": { "enum": ["not_required", "pending", "applicable", "adaptation_required", "not_applicable"] },
        "safetyReview": { "enum": ["not_required", "pending", "passed_with_boundary", "restricted", "blocked"] },
        "privacyReview": { "enum": ["not_required", "pending", "passed", "sensitive_private_only", "blocked"] },
        "rightsReview": { "enum": ["not_required", "pending", "approved", "restricted", "blocked"] },
        "promotionState": { "enum": ["research_only", "internal_review", "internal_canary", "public_candidate", "published", "retired"] },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" }, "uniqueItems": true },
        "portfolioRole": { "enum": ["representative_start", "repeat_reuse", "creator_variant", "official_trust_anchor", "breadth_candidate", "backup", "reference_keep", "provider_lead"] },
        "editorialAction": { "enum": ["keep", "revise", "import_source", "request_permission", "localize", "safety_review", "rights_review", "replace_source", "park", "reject"] },
        "backendStorable": { "type": "boolean" }
      }
    },
    "audienceAndApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "ageBands", "skillLevel", "contentLocale", "applicableLocales", "applicability", "prerequisites", "accountOrEntitlement", "collaborationContext", "userNeedSignals", "frictionSignals"],
      "properties": {
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["individual", "parent_guardian", "learner", "professional", "creator_operator", "caregiver", "team_member", "buyer", "traveler"] } },
        "ageBands": { "type": "array", "uniqueItems": true, "items": { "enum": ["child", "teen", "adult", "older_adult", "all_ages", "not_specified"] } },
        "skillLevel": { "enum": ["beginner", "intermediate", "advanced", "mixed", "not_applicable"] },
        "contentLocale": { "$ref": "#/$defs/nonEmptyString" },
        "applicableLocales": { "$ref": "#/$defs/stringArray" },
        "applicability": { "enum": ["local_direct", "local_adaptation_required", "global_general", "unknown"] },
        "prerequisites": { "$ref": "#/$defs/stringArray" },
        "accountOrEntitlement": { "enum": ["none", "free_account", "paid_subscription", "owned_product", "official_eligibility", "source_file_required", "unknown"] },
        "collaborationContext": { "enum": ["solo", "shared_household", "caregiver_dependent", "team_roles", "provider_client", "unknown"] },
        "userNeedSignals": { "type": "array", "uniqueItems": true, "items": { "enum": ["remember_when", "avoid_omission", "follow_sequence", "repeat_consistently", "track_progress", "choose_between_options", "queue_resources", "handoff_or_share", "preserve_source_context"] } },
        "frictionSignals": { "type": "array", "uniqueItems": true, "items": { "enum": ["tab_switching", "copy_reformatting", "missed_deadline", "lost_progress", "unclear_next_action", "collaboration_gap", "source_revisit_cost"] } }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomy", "audienceAndApplicability", "access", "rights", "review"],
      "properties": {
        "taxonomy": { "$ref": "#/$defs/taxonomyAssignment" },
        "audienceAndApplicability": { "$ref": "#/$defs/audienceAndApplicability" },
        "access": { "$ref": "#/$defs/access" },
        "rights": { "$ref": "#/$defs/rights" },
        "review": { "$ref": "#/$defs/reviewState" }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flowId", "title", "userJob", "stepIds", "anchorDefinitions"],
      "properties": {
        "flowId": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "userJob": { "$ref": "#/$defs/nonEmptyString" },
        "stepIds": { "$ref": "#/$defs/stringArray" },
        "anchorDefinitions": { "type": "array", "items": { "type": "object" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "flowId", "title", "order", "itemIds", "sourceRowIds"],
      "properties": {
        "stepId": { "$ref": "#/$defs/nonEmptyString" },
        "flowId": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "order": { "type": "integer", "minimum": 0 },
        "itemIds": { "$ref": "#/$defs/stringArray" },
        "sourceRowIds": { "$ref": "#/$defs/stringArray" }
      }
    },
    "evidenceBoundValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "sourceRowIds", "evidenceQuote", "userInputPath"],
      "properties": {
        "value": { "type": ["string", "number", "boolean", "null"] },
        "sourceRowIds": { "$ref": "#/$defs/stringArray" },
        "evidenceQuote": { "$ref": "#/$defs/nullableString" },
        "userInputPath": { "$ref": "#/$defs/nullableString" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "doneWhen"],
      "properties": {
        "mode": { "enum": ["check", "decision", "record"] },
        "doneWhen": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "stepId", "title", "intent", "order", "completion", "schedule", "recurrence", "fieldIds", "memoIds", "referenceIds", "conditionalResponseIds", "sourceRowIds"],
      "properties": {
        "itemId": { "$ref": "#/$defs/nonEmptyString" },
        "stepId": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "intent": { "enum": ["act", "inspect", "decide", "record", "use_resource"] },
        "order": { "type": "integer", "minimum": 0 },
        "completion": { "$ref": "#/$defs/completion" },
        "schedule": { "oneOf": [{ "$ref": "#/$defs/evidenceBoundValue" }, { "type": "null" }] },
        "recurrence": { "oneOf": [{ "$ref": "#/$defs/evidenceBoundValue" }, { "type": "null" }] },
        "fieldIds": { "$ref": "#/$defs/stringArray" },
        "memoIds": { "$ref": "#/$defs/stringArray" },
        "referenceIds": { "$ref": "#/$defs/stringArray" },
        "conditionalResponseIds": { "$ref": "#/$defs/stringArray" },
        "sourceRowIds": { "$ref": "#/$defs/stringArray" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "label", "value", "valueType", "sourceRowIds", "userEditable"],
      "properties": {
        "fieldId": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "value": {},
        "valueType": { "enum": ["string", "number", "boolean", "date", "datetime", "duration", "url", "enum"] },
        "sourceRowIds": { "$ref": "#/$defs/stringArray" },
        "userEditable": { "type": "boolean" }
      }
    },
    "memo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoId", "kind", "text", "sourceRowIds"],
      "properties": {
        "memoId": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["detail", "caution", "source_fact", "creator_experience", "user_note", "omission_note"] },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRowIds": { "$ref": "#/$defs/stringArray" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceId", "label", "url", "sourceRowIds"],
      "properties": {
        "referenceId": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "type": "string", "format": "uri" },
        "sourceRowIds": { "$ref": "#/$defs/stringArray" }
      }
    },
    "conditionalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditionalResponseId", "trigger", "response", "severity", "sourceRowIds", "evidenceQuote"],
      "properties": {
        "conditionalResponseId": { "$ref": "#/$defs/nonEmptyString" },
        "trigger": { "$ref": "#/$defs/nonEmptyString" },
        "response": { "$ref": "#/$defs/nonEmptyString" },
        "severity": { "enum": ["info", "caution", "stop", "emergency"] },
        "sourceRowIds": { "$ref": "#/$defs/stringArray" },
        "evidenceQuote": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "canonicalDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "steps", "items", "fields", "memos", "references", "conditionalResponses"],
      "properties": {
        "flow": { "oneOf": [{ "$ref": "#/$defs/flow" }, { "type": "null" }] },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "memos": { "type": "array", "items": { "$ref": "#/$defs/memo" } },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "conditionalResponses": { "type": "array", "items": { "$ref": "#/$defs/conditionalResponse" } }
      }
    },
    "lossEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason", "severity"],
      "properties": {
        "field": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "severity": { "enum": ["none", "nonessential", "essential"] }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "payload", "essentialFieldsRetained", "lossManifest"],
      "properties": {
        "availability": { "enum": ["primary", "secondary", "fallback", "blocked", "not_applicable"] },
        "payload": { "type": ["object", "array", "null"] },
        "essentialFieldsRetained": { "$ref": "#/$defs/stringArray" },
        "lossManifest": { "type": "array", "items": { "$ref": "#/$defs/lossEntry" } }
      }
    },
    "projections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar", "checklist", "todo", "sheet", "memo"],
      "properties": {
        "calendar": { "$ref": "#/$defs/projection" },
        "checklist": { "$ref": "#/$defs/projection" },
        "todo": { "$ref": "#/$defs/projection" },
        "sheet": { "$ref": "#/$defs/projection" },
        "memo": { "$ref": "#/$defs/projection" }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editLevel", "minutes", "itemKeepRate", "notes"],
      "properties": {
        "editLevel": { "enum": ["none", "minor", "major", "full_regeneration", "not_reviewed"] },
        "minutes": { "type": ["number", "null"], "minimum": 0 },
        "itemKeepRate": { "type": ["number", "null"], "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validatorStatus", "independentReviewIds", "correction", "unresolvedDisagreements"],
      "properties": {
        "validatorStatus": { "enum": ["not_run", "pass", "fail"] },
        "independentReviewIds": { "$ref": "#/$defs/stringArray" },
        "correction": { "$ref": "#/$defs/correction" },
        "unresolvedDisagreements": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
