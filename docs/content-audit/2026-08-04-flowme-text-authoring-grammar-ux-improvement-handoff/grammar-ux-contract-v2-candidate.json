{
  "schemaVersion": "flowme-text-authoring-grammar-ux-contract-v2-candidate",
  "createdAt": "2026-08-04",
  "status": "candidate_for_implementation_review",
  "claimBoundary": "내부 설계 및 자동 시뮬레이션 계약이며 사용자 검증이 아니다.",
  "invariants": [
    "원문은 항상 보존한다.",
    "명시적 구조 표식이 없는 문장은 canonical Item으로 자동 생성하지 않는다.",
    "속성 bullet 수는 canonical Item 수를 늘리지 않는다.",
    "Calendar 표시 정렬은 원문을 자동 재작성하지 않는다.",
    "기준일이 없는 상대 날짜를 실제 날짜로 추정하지 않는다.",
    "결과 형태 슬롯의 위치와 순서는 입력 내용에 따라 바뀌지 않는다."
  ],
  "canonicalSyntax": {
    "flowTitle": {
      "pattern": "# {title}",
      "cardinality": "one_per_document"
    },
    "flowAnchor": {
      "pattern": "- 기준일: YYYY-MM-DD",
      "scope": "flow",
      "position": "after_flow_title_before_first_step",
      "requiredFor": [
        "relative_date_calendar_projection"
      ]
    },
    "step": {
      "pattern": "## {step title}",
      "scope": "flow"
    },
    "item": {
      "pattern": "- [ ] {item title}",
      "scope": "step",
      "order": "source_order"
    },
    "itemProperty": {
      "pattern": "  - {official key}: {value}",
      "minimumIndentSpaces": 2,
      "requiresCurrentItem": true,
      "forbidsCheckbox": true,
      "officialKeys": [
        "설명",
        "날짜",
        "상대 날짜",
        "시간",
        "시간대",
        "소요 시간",
        "장소",
        "완료 기준",
        "반복",
        "조건",
        "자료"
      ]
    },
    "plainText": {
      "definition": "heading, flow field, item, item property 표식에 해당하지 않는 줄",
      "behavior": "원문 텍스트로 보존하고 Item을 만들지 않는다."
    },
    "unsupportedNestedItem": {
      "pattern": "  - [ ] {child title}",
      "behavior": "unsupported_nested_item issue로 원문 보존",
      "mustNot": [
        "자동 평탄화",
        "부모 속성으로 해석"
      ]
    },
    "unknownProperty": {
      "pattern": "  - {unknown key}: {value}",
      "behavior": "unknown_property issue로 원문 보존",
      "mustNot": [
        "새 Item 생성",
        "설명 필드로 추정"
      ]
    }
  },
  "parsePrecedence": [
    "heading",
    "table_csv_tsv_markdown_table",
    "flow_level_official_field",
    "indented_official_property_bullet",
    "indented_unknown_property_issue",
    "item_list",
    "v1_property_compatibility",
    "plain_text_preservation"
  ],
  "compatibility": {
    "read": [
      "v1 대시 없는 들여쓴 속성",
      "1. 또는 2) 번호 목록 가져오기",
      "legacy 속성 별칭",
      "CSV, TSV, Markdown table"
    ],
    "write": [
      "v2 item property bullet",
      "- [ ] item marker",
      "official property labels only"
    ],
    "migration": "v1은 읽되 writer 저장 시 v2로 정규화하고 비파괴 변경 요약을 제공한다.",
    "versionChangeRequired": [
      "flowme-authoring-markdown-v1 -> v2",
      "flowme-supported-markdown-v1 -> v2",
      "text-authoring contract v1 -> v2"
    ]
  },
  "ordering": {
    "canonical": "source_order",
